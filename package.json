{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "read-shunt-plugin",
  "version": "0.3.0",
  "description": "Reduce large read results before they enter OpenCode, Codex, or Pi context.",
  "type": "module",
  "license": "MIT",
  "author": "p5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p5/read-shunt-plugin.git"
  },
  "homepage": "https://github.com/p5/read-shunt-plugin#readme",
  "bugs": "https://github.com/p5/read-shunt-plugin/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codex",
    "codex-plugin",
    "pi",
    "pi-package",
    "token-optimization"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "extensions",
    "hooks",
    ".codex-plugin",
    ".agents",
    "benchmarks",
    "server.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:build": "bun build src/index.ts src/codex/main.ts extensions/read-shunt.ts --outdir dist --target bun --format esm --external @opencode-ai/plugin --external @earendil-works/pi-ai --external @earendil-works/pi-coding-agent && tsc -p tsconfig.build.json",
    "eval:live": "bun run eval/live.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "beta"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.7",
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@types/bun": "latest",
    "@types/json-schema": "latest",
    "typescript": "latest"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "pi": {
    "extensions": [
      "./extensions/read-shunt.ts"
    ]
  }
}
